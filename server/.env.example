NODE_ENV=development
PORT=3000
PORT_V1=3001
PORT_V2=3002

MONGODB_URI=mongodb://localhost:27017/iitghabapp?replicaSet=rs0
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/postgres

JWT_SECRET="jwt-secret"
ADMIN_JWT_SECRET="admin-jwt-secret"
REFRESH_SECRET="refresh-secret"

CLIENT_ID="your_azure_client_id"
CLIENT_SECRET="your_azure_client_secret"
TENANT_ID="your_azure_tenant_id"

# OAuth redirect URIs (must match Azure registration exactly)
WEB_REDIRECT_URI="http://localhost:3000/api/auth/login/redirect/web"
REDIRECT_URI="http://localhost:3000/api/auth/login/redirect/mobile"
PUBLIC_BASE_URL="http://localhost:3000"

# Frontend base URLs for server redirects
HAB_FRONTEND_URL="http://localhost:5173/hab"
HOSTEL_FRONTEND_URL="http://localhost:5174/hostel"
SMC_FRONTEND_URL="http://localhost:5175/smc"

# LaTeX config
STATION_LEAVE_LATEX_IMAGE="iitg-station-leave-latex:local"
STATION_LEAVE_DOCKER_BIN="docker"

# OneDrive config
ONEDRIVE_STORAGE_USER_UPN="your_email@iitg.ac.in"
ONEDRIVE_DRIVE_ID="your_onedrive_drive_id"
ONEDRIVE_REPORTS_FOLDER_ID="your_reports_folder_id"
ONEDRIVE_LEAVE_FOLDER_ID="your_leave_folder_id"
ONEDRIVE_PROFILE_PICS_FOLDER_ID="your_profile_pics_folder_id"
ONEDRIVE_FESTIVALS_FOLDER_ID="your_festivals_folder_id"

# HAB authorized mails
HAB_EMAIL="admin@iitg.ac.in"
HAB_EMAIL2="admin2@iitg.ac.in"

# Testing
REAL_ROLL_NUMBER=250000000
FAKETIME=
